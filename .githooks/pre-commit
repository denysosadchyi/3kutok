#!/bin/sh
# Гейт дизайн-системи: коміт не проходить, якщо дизайн-файли вносять
# токени, яких немає в design-system/tokens.css, чи сирі значення.
# Підключення (раз на клон): git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
python3 "$root/design-system/_gate.py" || exit 1

# STE-UA: staged .md і .html мусять пройти лінтер (tools/ste/RULES.md).
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md' '*.html')
[ -z "$files" ] && exit 0
cd "$root" && python3 tools/ste/check.py $files || {
  echo "Коміт зупинено: виправте текст за STE-UA (tools/ste/RULES.md)." >&2
  exit 1
}
